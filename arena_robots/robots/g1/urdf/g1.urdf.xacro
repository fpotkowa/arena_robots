<?xml version="1.0"?>
<robot name="g1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- G1 constants from unitree g1_29dof_rev_1_0.urdf -->
  <property name="PI" value="3.141592653589793"/>

  <!-- Colors -->
  <material name="dark">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="white">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>

  <xacro:arg name="prefix" default="" />
  <xacro:arg name="namespace" default="" />
  <xacro:arg name="gazebo_classic" default="false" />
  <xacro:arg name="gazebo_ignition" default="true" />

  <xacro:include filename="$(find arena_robots)/robots/g1/urdf/base_hw/g1.ros2_control.urdf" />

  <!-- Pelvis link -->
  <link name="$(arg prefix)pelvis">
    <inertial>
      <origin xyz="0 0 -0.07605" rpy="0 0 0"/>
      <mass value="3.813"/>
      <inertia ixx="0.010549" ixy="0" ixz="2.1E-06" iyy="0.0093089" iyz="0" izz="0.0079184"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arena_robots/robots/g1/meshes/pelvis.STL"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arena_robots/robots/g1/meshes/pelvis.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Pelvis contour link -->
  <link name="$(arg prefix)pelvis_contour_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>

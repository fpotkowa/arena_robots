      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arena_robots/robots/g1/meshes/head_link.STL"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arena_robots/robots/g1/meshes/head_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg prefix)head_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0039635 0 -0.044"/>
    <parent link="$(arg prefix)torso_link"/>
    <child link="$(arg prefix)head_link"/>
  </joint>

  <!-- IMU -->
  <link name="$(arg prefix)imu_in_torso">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="$(arg prefix)imu_in_torso_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.03959 -0.00224 0.14792"/>
    <parent link="$(arg prefix)torso_link"/>
    <child link="$(arg prefix)imu_in_torso"/>
  </joint>

  <!-- D435 Camera -->
  <link name="$(arg prefix)d435_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="$(arg prefix)d435_joint" type="fixed">
    <origin rpy="0 0.8307767239493009 0" xyz="0.0576235 0.01753 0.42987"/>
    <parent link="$(arg prefix)torso_link"/>
    <child link="$(arg prefix)d435_link"/>
  </joint>

  <!-- Mid360 Lidar -->
  <link name="$(arg prefix)mid360_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="$(arg prefix)mid360_joint" type="fixed">
    <origin rpy="3.141592653589793 0.05112069379091391 0" xyz="0.0002835 0.00003 0.428434"/>
    <parent link="$(arg prefix)torso_link"/>
    <child link="$(arg prefix)mid360_link"/>
  </joint>

  <!-- Arms -->
  <xacro:macro name="g1_arm" params="side prefix">
    <link name="${prefix}${side}_shoulder_pitch_link">
      <inertial>
        <origin xyz="0 0.035892 -0.011628" rpy="0 0 0"/>
        <mass value="0.718"/>
        <inertia ixx="0.0004291" ixy="-9.2E-06" ixz="6.4E-06" iyy="0.000453" iyz="2.26E-05" izz="0.000423"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_shoulder_pitch_link.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 1.5707963267948966 0" xyz="0 0.04 -0.01"/>
        <geometry><cylinder radius="0.03" length="0.05"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}${side}_shoulder_pitch_joint" type="revolute">
      <origin rpy="0.27931 5.4949E-05 -0.00019159" xyz="0.0039563 0.10022 0.24778"/>
      <parent link="${prefix}torso_link"/>
      <child link="${prefix}${side}_shoulder_pitch_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.0892" upper="2.6704" effort="25" velocity="37"/>
    </joint>

    <link name="${prefix}${side}_shoulder_roll_link">
      <inertial>
        <origin xyz="-0.000227 0.00727 -0.063243" rpy="0 0 0"/>
        <mass value="0.643"/>
        <inertia ixx="0.0006177" ixy="-1E-06" ixz="8.7E-06" iyy="0.0006912" iyz="-5.3E-06" izz="0.0003894"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_shoulder_roll_link.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="-0.004 0.006 -0.053"/>
        <geometry><cylinder radius="0.03" length="0.03"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}${side}_shoulder_roll_joint" type="revolute">
      <origin rpy="-0.27925 0 0" xyz="0 0.038 -0.013831"/>
      <parent link="${prefix}${side}_shoulder_pitch_link"/>
      <child link="${prefix}${side}_shoulder_roll_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.5882" upper="2.2515" effort="25" velocity="37"/>
    </joint>

    <link name="${prefix}${side}_shoulder_yaw_link">
      <inertial>
        <origin xyz="0.010773 -0.002949 -0.072009" rpy="0 0 0"/>
        <mass value="0.734"/>
        <inertia ixx="0.0009988" ixy="7.9E-06" ixz="0.0001412" iyy="0.0010605" iyz="-2.86E-05" izz="0.0004354"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_shoulder_yaw_link.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_shoulder_yaw_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}${side}_shoulder_yaw_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0 0.00624 -0.1032"/>
      <parent link="${prefix}${side}_shoulder_roll_link"/>
      <child link="${prefix}${side}_shoulder_yaw_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.618" upper="2.618" effort="25" velocity="37"/>
    </joint>

    <link name="${prefix}${side}_elbow_link">
      <inertial>
        <origin xyz="0.064956 0.004454 -0.010062" rpy="0 0 0"/>
        <mass value="0.6"/>
        <inertia ixx="0.0002891" ixy="6.53E-05" ixz="1.72E-05" iyy="0.0004152" iyz="-5.6E-06" izz="0.0004197"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_elbow_link.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_elbow_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}${side}_elbow_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0.015783 0 -0.080518"/>
      <parent link="${prefix}${side}_shoulder_yaw_link"/>
      <child link="${prefix}${side}_elbow_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.0472" upper="2.0944" effort="25" velocity="37"/>
    </joint>

    <link name="${prefix}${side}_wrist_roll_link">
      <inertial>
        <origin xyz="0.01713944778 0.00053759094 0.00000048864" rpy="0 0 0"/>
        <mass value="0.08544498"/>
        <inertia ixx="0.00004821544023" ixy="-0.00000424511021" ixz="0.00000000510599" iyy="0.00003722899093" iyz="-0.00000000123525" izz="0.00005482106541"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_wrist_roll_link.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_wrist_roll_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}${side}_wrist_roll_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0.100 0.00188791 -0.010"/>
      <parent link="${prefix}${side}_elbow_link"/>
      <child link="${prefix}${side}_wrist_roll_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.972222054" upper="1.972222054" effort="25" velocity="37"/>
    </joint>

    <link name="${prefix}${side}_wrist_pitch_link">
      <inertial>
        <origin xyz="0.02299989837 -0.00111685314 -0.00111658096" rpy="0 0 0"/>
        <mass value="0.48404956"/>
        <inertia ixx="0.00016579646273" ixy="-0.00001231206746" ixz="0.00001231699194" iyy="0.00042954057410" iyz="0.00000081417712" izz="0.00042953697654"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_wrist_pitch_link.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_wrist_pitch_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}${side}_wrist_pitch_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0.038 0 0"/>
      <parent link="${prefix}${side}_wrist_roll_link"/>
      <child link="${prefix}${side}_wrist_pitch_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.614429558" upper="1.614429558" effort="5" velocity="22"/>
    </joint>

    <link name="${prefix}${side}_wrist_yaw_link">
      <inertial>
        <origin xyz="0.02200381568 0.00049485096 0.00053861123" rpy="0 0 0"/>
        <mass value="0.08457647"/>
        <inertia ixx="0.00004929128828" ixy="-0.00000045735494" ixz="0.00000445867591" iyy="0.00005973338134" iyz="0.00000043217198" izz="0.00003928083826"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_wrist_yaw_link.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_wrist_yaw_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}${side}_wrist_yaw_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0.046 0 0"/>
      <parent link="${prefix}${side}_wrist_pitch_link"/>
      <child link="${prefix}${side}_wrist_yaw_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.614429558" upper="1.614429558" effort="5" velocity="22"/>
    </joint>

    <link name="${prefix}${side}_rubber_hand">
      <inertial>
        <origin xyz="0.05361310808 ${-0.00295905240 if side == 'left' else 0.00295905240} 0.00215413091" rpy="0 0 0"/>
        <mass value="0.170"/>
        <inertia ixx="0.00010099485234748" ixy="0.00003618590790516" ixz="-0.00000074301518642" iyy="0.00028135871571621" iyz="0.00000330189743286" izz="0.00021894770413514"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_robots/robots/g1/meshes/${side}_rubber_hand.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
    </link>

    <joint name="${prefix}${side}_hand_palm_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0.0415 0.003 0"/>
      <parent link="${prefix}${side}_wrist_yaw_link"/>
      <child link="${prefix}${side}_rubber_hand"/>
    </joint>
  </xacro:macro>

  <xacro:g1_arm side="left" prefix="$(arg prefix)"/>
  <xacro:g1_arm side="right" prefix="$(arg prefix)"/>

  <!-- Gazebo plugins -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg namespace)/config/gz_controllers.yaml</parameters>
      <ros>
        <namespace>$(arg namespace)</namespace>
      </ros>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
    </plugin>
  </gazebo>

  <gazebo reference="$(arg prefix)left_ankle_roll_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="$(arg prefix)right_ankle_roll_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

</robot>
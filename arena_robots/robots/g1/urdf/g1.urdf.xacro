      </geometry>
    </collision>
  </link>

  <joint name="$(arg prefix)pelvis_contour_joint" type="fixed">
    <parent link="$(arg prefix)pelvis"/>
    <child link="$(arg prefix)pelvis_contour_link"/>
  </joint>

  <!-- Left Leg -->
  <link name="$(arg prefix)left_hip_pitch_link">
